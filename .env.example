# ==============================================================================
# JalDrishti — Environment Configuration Template
# NOTE: Never commit secrets or actual production credentials to version control.
# Copy this file to .env and configure the respective API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Platform Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Spatial Database & Cache Layer (Phase 15)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://jaldrishti_user:password@localhost:5432/jaldrishti_spatial"
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# Meteorological Telemetry (Phase 5)
# ------------------------------------------------------------------------------
# Open-Meteo operates keyless by default for educational/prototype workloads.
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"

# ------------------------------------------------------------------------------
# Earth Observation Satellite Pipelines (Phases 3 & 4)
# ------------------------------------------------------------------------------
# Copernicus Data Space Ecosystem (CDSE) / AWS STAC API for Sentinel-2 L2A
SENTINEL_PROVIDER_URL="https://catalogue.dataspace.copernicus.eu/resto/api/collections/Sentinel2/search.json"
SENTINEL_API_KEY=""

# NASA Earthdata / LP DAAC for MODIS Land Surface Temperature (MOD11A1)
NASA_EARTHDATA_USERNAME=""
NASA_EARTHDATA_PASSWORD=""

# ------------------------------------------------------------------------------
# Hydrology & River Basin Feeds (Phase 6)
# ------------------------------------------------------------------------------
# Central Water Commission (CWC) / India-WRIS River Gauge Telemetry
HYDROLOGY_API_URL=""
HYDROLOGY_API_KEY=""

# ------------------------------------------------------------------------------
# Water Quality Ingestion Layer (Phase 7)
# ------------------------------------------------------------------------------
# Central Pollution Control Board (CPCB) National Water Quality Monitoring Programme
WATER_QUALITY_API_URL=""
WATER_QUALITY_API_KEY=""

# ------------------------------------------------------------------------------
# Epidemiological & Public Health Feeds (Phase 8)
# ------------------------------------------------------------------------------
# Integrated Disease Surveillance Programme (IDSP / IHIP) Authorized Gateway
HEALTH_API_URL=""
HEALTH_API_KEY=""

# ------------------------------------------------------------------------------
# IoT In-Situ Sensor Gateway (Phase 10)
# ------------------------------------------------------------------------------
# MQTT Broker for edge telemetry nodes (LoRaWAN / cellular gateway)
MQTT_BROKER_URL=""
MQTT_USERNAME=""
MQTT_PASSWORD=""

# ------------------------------------------------------------------------------
# AI Studio & LLM Grounding (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
